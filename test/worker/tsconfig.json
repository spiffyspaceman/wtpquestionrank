{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "types": ["@cloudflare/vitest-plugin/types", "vite/client"]
  },
  "include": ["./**/*.ts", "../../src/worker/**/*.ts", "../../src/rating/*.ts"],
  "exclude": ["../../src/rating/*.test.ts"]
}
