// WTP Question Rank: one Worker, static pages from dist/, one D1 database.
// Secrets are never in this file. The owner enters CODE_PEPPER and TURNSTILE_SECRET (and, only if Access is not
// used, ADMIN_SECRET) with `wrangler secret put` or the dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wtpquestionrank",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",

  // Production is served only on the Custom Domain. No workers.dev route and no Version URLs.
  "workers_dev": false,
  "preview_urls": false,

  // Every request goes through the Worker first, so security headers and the host guard apply to pages too.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wtpquestionrank",
      "database_id": "de56eb48-9566-4c23-ae18-ade6593e10dc",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "PROD_HOST": "wtpquestionrank.spiffyspaceman.com",
    // Filled in at BUILD_STEPS §9 step 5, from the Access application.
    "ACCESS_TEAM_DOMAIN": "falling-mouse-d5eb.cloudflareaccess.com",
    "ACCESS_AUD": "a5fd1dc2760da4c1ecaee3136d0063fdfddca1274d040f223ed0db0d481af8cf",
    // Public site key of the Turnstile widget (§9 step 4). The secret key is a Worker secret.
    "TURNSTILE_SITEKEY": "0x4AAAAAAGRX_q6QWAvfeUgg"
  },

  // Branch previews get no bindings at all: no D1, no secrets. They can serve static pages only.
  "previews": {}
}
